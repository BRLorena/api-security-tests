# Environment of the app under test. Local throwaway values; CI overrides DATABASE_URL and
# AUTH_SECRET before sourcing. Each line keeps an existing value if already exported.
export DATABASE_URL="${DATABASE_URL:-postgresql://sectest:sectest@localhost:54329/finance}"
export POSTGRES_URL="${POSTGRES_URL:-$DATABASE_URL}"
export AUTH_SECRET="${AUTH_SECRET:-local-security-tests-secret-not-used-anywhere-else}"
export AUTH_TRUST_HOST=true
export AUTH_URL="${AUTH_URL:-http://localhost:3100}"
# AI features are out of scope here (see ai-feature-tests): no key, no model calls.
export GROQ_API_KEY="${GROQ_API_KEY:-disabled}"
# This suite does not assert the in-memory limiter; disabling it stops account creation from
# being throttled when many workers register at once.
export DISABLE_RATE_LIMIT=true
